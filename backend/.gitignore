# Secrets — NEVER commit
.env
*.env
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# Logs & temp
*.log
*.json.tmp
*.tmp

# OS
Thumbs.db
.DS_Store

# R1 cleaned output (derived, reproducible)
data/clean/
data/r2/
data/r3/
data/r4/
data/r5/
data/backups/

# Runtime state: never shipped, never pinned. AI answers are cached here so a
# live request cannot change the fingerprint of data/build/dictionary.sqlite.
data/runtime/

# Tool caches (e.g. tools/enrich_csv_images.py query -> candidate memory).
# Everything here is reproducible by re-running the tool, so it must not enter
# the repo: a stale cache would make a later run silently skip lookups.
.cache/

# Category illustrations are generated by tools/build_category_illustrations.py.
# The bundled copies live in ../assets/images/thumbs/; the originals this script
# writes next to the backend are byte-identical duplicates and stay untracked.
assets/
