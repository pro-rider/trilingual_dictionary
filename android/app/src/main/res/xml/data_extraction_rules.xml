<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup/transfer rules: the dictionary database, the local
     user.db (favorites, history) and any token must never leave the device
     through cloud backup or device-to-device transfer. Session tokens are
     re-obtained by signing in; offline data is rebuilt on first run. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
