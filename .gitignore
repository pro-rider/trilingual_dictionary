# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# Secrets — NEVER commit
.env
*.env
!.env.example

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Dictionary build artifacts (regenerated, not source)
/backend/data/raw/
/backend/data/build/


/backend/data/images/

# Past-paper transcriptions and course PDFs stay local (copyrighted course material)
/backend/data/exam/

# Bundled offline dictionary (42.5 MB asset, regenerated by project_guide §8.7)
/assets/data/dictionary.sqlite.gz
# …and the uncompressed copy a verify run leaves behind
/assets/data/dictionary.sqlite

# Nested thumbnails are never bundled: pubspec declares `assets/images/thumbs/`
# and Flutter packs only the files directly in that directory, so a nested
# reference renders as an empty card. Guarded by tools/verify_image_assets.py.
/assets/images/thumbs/*/

# Acquisition bookkeeping from backend/tools/images_v2.py (build artifacts).
/assets/images/detail/
/assets/images/manifest_v2_*.jsonl
/assets/images/report_v2*.json

# Human review workbooks (regenerated by backend/tools/build_review_packages.py;
# only review/README.md is tracked). Reviewer copies live outside git on purpose.
/review/*.xlsx
/review/*.csv

# Generated at deploy time: upstream list reports licence NOASSERTION (/backend/data/disposable_email_blocklist.conf
/backend/data/disposable_email_blocklist.conf
/backend/data/DISPOSABLE-LICENSE.txt

# Raw upstream downloads (hanzi-writer-data package + Unihan files, ~102 MB).
# Reproducible from tools/build_stroke_pack.py and the recorded checksums; never
# committed, so the public tree stays small and no third-party blob is republished.
stroke_work/
