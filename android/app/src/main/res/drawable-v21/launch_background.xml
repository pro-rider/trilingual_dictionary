<?xml version="1.0" encoding="utf-8"?>
<!-- Launch window (API 21+). Uses the app's own colour instead of
     ?android:colorBackground so an OEM theme cannot turn the launch into a
     white flash in dark mode. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />
</layer-list>
