<?xml version="1.0" encoding="utf-8"?>
<!-- Launch window: a flat app-coloured background, no logo and no copyright
     asset. The colour is resolved from values/colors.xml or
     values-night/colors.xml, so the OS dark-mode setting picks the right one
     before Flutter has drawn anything. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />
</layer-list>
