# Trilingual Dictionary backend — environment example
# Copy to .env and fill in as needed.

# PostgreSQL authoritative source (used when wired up)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/trilingual_dictionary

# CORS — set the Flutter app origin(s) for production; "*" for dev only
CORS_ORIGINS=["*"]

# Offline-first dataset (v1 reads from this JSON until Postgres is seeded)
DATASET_PATH=data/seed/en_zh_ne.json
DATASET_VERSION=1

# AI provider — NEVER expose these to the Flutter app. Disabled by default.
# Set AI_ENABLED=true + at least one provider key to generate arbitrary words
# on the fly (English ⇄ 中文 + नेपाली).
AI_ENABLED=false
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://api.groq.com/openai/v1

# ---- Multi-provider LLM failover (Groq → Gemini → OpenRouter) ----
AI_PROVIDERS_ORDER=groq,gemini,openrouter
AI_MAX_RETRIES=1
AI_RETRY_BACKOFF_SECONDS=0.5
CIRCUIT_FAIL_THRESHOLD=3
CIRCUIT_COOLDOWN_SECONDS=30

# Groq (OpenAI-compatible). Leave empty to use the legacy AI_* fields above.
GROQ_API_KEY=
GROQ_MODEL=
GROQ_TIMEOUT=40
GROQ_ENABLED=true

# Google Gemini (native API, free tier)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT=40
GEMINI_ENABLED=true

# OpenRouter (OpenAI-compatible, free models)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-70b-instruct
OPENROUTER_TIMEOUT=40
OPENROUTER_ENABLED=true

# Supabase auth (optional). Get the JWT secret from Supabase Dashboard →
# Settings → API → JWT Secret. Set to enable /me, favorites, feedback.
SUPABASE_URL=
SUPABASE_JWT_SECRET=
