# Trilingual Dictionary backend — environment example
# Copy to .env and fill in as needed.

# PostgreSQL authoritative source (used when wired up)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/trilingual_dictionary

# CORS — set the Flutter app origin(s) for production; "*" for dev only
CORS_ORIGINS=["*"]

# Offline-first dataset (v1 reads from this JSON until Postgres is seeded)
DATASET_PATH=data/seed/en_zh_ne.json
DATASET_VERSION=1

# AI provider — NEVER expose these to the Flutter app. Disabled by default.
# Set AI_ENABLED=true + at least one provider key to generate arbitrary words
# on the fly (English ⇄ 中文 + नेपाली).
AI_ENABLED=false
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://api.groq.com/openai/v1

# ---- Runtime guards on the four AI-spending routes --------------------------
# Applies to /search, /analyze/text, /dictionary/enrich and /search/sentence.
# AI_SHARED_SECRET: when set, every one of those routes requires the
# X-AI-Token header. Empty = no token required (the app's current behaviour).
AI_SHARED_SECRET=
# Per-client sliding window and process-wide daily ceiling. Counted on every
# guarded request, whether or not a model answers. The built-in defaults are
# 60 / 2000; set 0 to switch a limit off deliberately.
# AI_RATE_LIMIT_PER_MIN=60
# AI_DAILY_CAP=2000

# ---- Multi-provider LLM failover (Groq → Gemini → OpenRouter) ----
AI_PROVIDERS_ORDER=groq,gemini,openrouter
AI_MAX_RETRIES=1
AI_RETRY_BACKOFF_SECONDS=0.5
CIRCUIT_FAIL_THRESHOLD=3
CIRCUIT_COOLDOWN_SECONDS=30

# Groq (OpenAI-compatible). Leave empty to use the legacy AI_* fields above.
GROQ_API_KEY=
GROQ_MODEL=
GROQ_TIMEOUT=40
GROQ_ENABLED=true

# Google Gemini (native API, free tier)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT=40
GEMINI_ENABLED=true

# OpenRouter (OpenAI-compatible). The model below is PAID and is therefore
# disabled by the strict zero-cost policy; the 12 verified :free models are
# configured in app/ai/registry.py and re-verified against the live catalogue.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-70b-instruct
OPENROUTER_TIMEOUT=40
OPENROUTER_ENABLED=true

# ---- Strict zero-cost failover (20-slot registry) --------------------------
# Fail closed: a model may only run when both prices are verified as 0. A model
# whose free status cannot be verified stays in the registry, disabled, with a
# reason. Paid fallback is hard-coded off; there is no switch that turns it on.
AI_FREE_ONLY=true
AI_MAX_MODELS=20
AI_MAX_ATTEMPTS_PER_REQUEST=6
AI_MAX_RETRIES_PER_PROVIDER=2
AI_REQUEST_TIMEOUT_SECONDS=45
AI_MAX_TOTAL_REQUEST_SECONDS=180
AI_ENABLE_LOCAL_FALLBACK=false
AI_ENABLE_PAID_FALLBACK=false
AI_STRICT_ZERO_COST=true
AI_MODEL_DISCOVERY_ENABLED=true
AI_MODEL_DISCOVERY_INTERVAL_HOURS=24
AI_OUTPUT_VALIDATION_ENABLED=true
# Conservative self-imposed guards, NOT provider-published limits.
AI_FREE_QUOTA_RPM=20
AI_FREE_QUOTA_RPD=1000
# Where the verified-free catalogue snapshot is cached (optional override).
# AI_MODEL_CACHE_FILE=

# Supabase auth (optional). Get the JWT secret from Supabase Dashboard →
# Settings → API → JWT Secret. Set to enable /me, favorites, feedback.
SUPABASE_URL=
SUPABASE_JWT_SECRET=
# Server-side only: used by DELETE /auth/account to remove an identity.
# NEVER put this in the Flutter app, any web client, or git.
SUPABASE_SERVICE_ROLE_KEY=
# Also server-side only. The Flutter app never receives it (A24).
SUPABASE_ANON_KEY=

# Pepper for the emailed code and signup-token hashes. Any long random
# string; changing it invalidates every code in flight.
AUTH_CODE_PEPPER=
AUTH_SIGNUP_TOKEN_TTL_SECONDS=900
AUTH_SEND_WINDOW_SECONDS=3600

# Transactional email (Resend). The key is server-side only.
RESEND_API_KEY=
AUTH_MAIL_FROM=no-reply@example.com

# Comma-separated proxy CIDRs whose X-Forwarded-For may be trusted.
# Leave empty unless a proxy you control sets it (A27).
TRUSTED_PROXIES=

# Auth policy (docs/AUTH-SCHEMA.md §5). Defaults are the documented ones.
AUTH_CODE_TTL_MINUTES=10
AUTH_MAX_CODE_ATTEMPTS=5
AUTH_RESEND_COOLDOWN_SECONDS=60
AUTH_MAX_EMAILS_PER_HOUR=5
AUTH_LOCKOUT_STEPS_SECONDS=60,300,900
AUTH_USERNAME_MIN_LENGTH=3
AUTH_USERNAME_MAX_LENGTH=20
AUTH_PASSWORD_MIN_LENGTH=8
AUTH_PASSWORD_MAX_LENGTH=128

